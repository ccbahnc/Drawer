<Window x:Class="Drawer.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:Drawer" Title="Drawer">
 <local:DrawerResizeSurface x:Name="WindowSurface" Background="Transparent">
 <Border x:Name="MaterialCover" Background="{StaticResource DrawerSurfaceBrush}" IsHitTestVisible="False"/>
 <Border x:Name="DropSurface" Background="Transparent" HorizontalAlignment="Left" VerticalAlignment="Top" AllowDrop="True" RightTapped="DropSurface_RightTapped">
  <Grid x:Name="RootGrid" Padding="10" RowSpacing="0">
   <Grid.RowDefinitions><RowDefinition x:Name="DrawerTopRow" Height="32"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <Grid x:Name="LiveDrawerContent" Grid.RowSpan="2">
   <Grid x:Name="BackgroundSurface">
    <Grid.RowDefinitions><RowDefinition x:Name="ContentTopRow" Height="32"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <Grid x:Name="NavigationBar" Background="{StaticResource DrawerNavigationBrush}" CornerRadius="8" Padding="5,0,2,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="24"/></Grid.ColumnDefinitions>
    <Grid Background="Transparent">
     <TextBlock x:Name="DrawerName" DoubleTapped="Name_DoubleTapped" Foreground="{StaticResource DrawerForegroundBrush}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxLines="1"/>
     <TextBox x:Name="NameEditor" Visibility="Collapsed" MinWidth="0" MinHeight="0" Height="30" VerticalAlignment="Center" Padding="2" FontSize="12" KeyDown="Name_KeyDown" LostFocus="Name_LostFocus"/>
    </Grid>
    <Button x:Name="AddButton" Grid.Column="1" Width="24" Height="28" VerticalAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" MinWidth="0" MinHeight="0" Padding="0" Background="Transparent" Foreground="{StaticResource DrawerForegroundBrush}" BorderThickness="0" Click="Add_Click"><FontIcon Glyph="&#xE710;" FontSize="16" Foreground="{StaticResource DrawerForegroundBrush}"/></Button>
    <Button x:Name="GearButton" Grid.Column="2" Width="24" Height="28" VerticalAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" MinWidth="0" MinHeight="0" Padding="0" Background="Transparent" Foreground="{StaticResource DrawerForegroundBrush}" BorderThickness="0" Click="Gear_Click"><FontIcon Glyph="&#xE713;" FontSize="17" Foreground="{StaticResource DrawerForegroundBrush}"/></Button>
   </Grid>
   <Grid x:Name="GridHost" Grid.Row="1" Margin="0,6,0,0" Background="Transparent">
    <Grid.Resources><ItemsPanelTemplate x:Key="FolderItemsPanel"><VariableSizedWrapGrid Orientation="Horizontal" UseLayoutRounding="False"/></ItemsPanelTemplate></Grid.Resources>
    <Canvas>
    <GridView x:Name="ShortcutGrid" Background="Transparent" HorizontalAlignment="Left" VerticalAlignment="Top" IsItemClickEnabled="False" SelectionMode="Single" CanDragItems="False" CanReorderItems="False" AllowDrop="True" Padding="0" UseLayoutRounding="False" SizeChanged="ShortcutGrid_SizeChanged" ScrollViewer.VerticalScrollMode="Disabled" ScrollViewer.VerticalScrollBarVisibility="Hidden" ScrollViewer.HorizontalScrollMode="Disabled">
     <GridView.ItemContainerTransitions><TransitionCollection/></GridView.ItemContainerTransitions>
     <GridView.ItemsPanel><ItemsPanelTemplate><local:TopSlotPanel HorizontalAlignment="Left" UseLayoutRounding="False" Loaded="TopSlotPanel_Loaded"/></ItemsPanelTemplate></GridView.ItemsPanel>
     <GridView.ItemContainerStyle>
      <Style TargetType="GridViewItem">
       <Setter Property="MinWidth" Value="0"/>
       <Setter Property="MinHeight" Value="0"/>
       <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
       <Setter Property="VerticalContentAlignment" Value="Stretch"/>
       <Setter Property="UseSystemFocusVisuals" Value="True"/>
       <Setter Property="FocusVisualPrimaryBrush" Value="{StaticResource DrawerFocusBrush}"/>
       <Setter Property="FocusVisualPrimaryThickness" Value="1"/>
       <Setter Property="FocusVisualSecondaryThickness" Value="0"/>
       <Setter Property="FocusVisualMargin" Value="2"/>
       <Setter Property="CornerRadius" Value="8"/>
       <Setter Property="Margin" Value="0"/>
       <Setter Property="Template">
        <Setter.Value>
         <ControlTemplate TargetType="GridViewItem">
          <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
              HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
         </ControlTemplate>
        </Setter.Value>
       </Setter>
      </Style>
     </GridView.ItemContainerStyle>
     <GridView.ItemTemplate><DataTemplate>
      <Grid Background="Transparent" Padding="{Binding TilePadding}" ToolTipService.ToolTip="{Binding FileName}" AutomationProperties.Name="{Binding AccessibleName}" AutomationProperties.ItemStatus="{Binding SelectionStatus}">
       <StackPanel Spacing="{Binding NameSpacing}" Visibility="{Binding ContentVisibility}">
        <Grid Height="{Binding IconSize}">
         <Grid Width="{Binding IconSize}" HorizontalAlignment="Center" RenderTransformOrigin="0.5,0.5" IsHitTestVisible="False">
          <Grid.RenderTransform><ScaleTransform ScaleX="{Binding RenderedIconScale}" ScaleY="{Binding RenderedIconScale}"/></Grid.RenderTransform>
          <FontIcon Glyph="{Binding Glyph}" FontSize="{Binding IconSize}" Foreground="{StaticResource DrawerSelectionFillBrush}" Visibility="{Binding FallbackVisibility}"/>
          <Image Width="{Binding IconSize}" Height="{Binding IconSize}" Source="{Binding Icon}" Loaded="Icon_Loaded" DataContextChanged="Icon_DataContextChanged" Stretch="Uniform"/>
         </Grid>
        </Grid>
        <Grid x:Name="ShortcutNameSlot" Height="{Binding NameHeight}">
         <TextBlock x:Name="ShortcutNameLabel" Opacity="{Binding NameOpacity}" IsHitTestVisible="{Binding ShowNames}" Text="{Binding Name}" Foreground="{StaticResource DrawerForegroundBrush}" FontSize="{Binding NameFontSize}" TextTrimming="CharacterEllipsis" MaxLines="1" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Top"/>
        </Grid>
       </StackPanel>
       <Border Width="{Binding SelectionSize}" Height="{Binding SelectionSize}" CornerRadius="3" Visibility="{Binding SelectionVisibility}" HorizontalAlignment="Right" VerticalAlignment="{Binding SelectionAlignment}" Margin="{Binding SelectionMargin}" BorderThickness="1" BorderBrush="{StaticResource DrawerSelectionBorderBrush}" Background="{Binding SelectionBackground}" IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw">
        <TextBlock Text="{Binding SelectionGlyph}" Foreground="{StaticResource DrawerCheckBrush}" FontSize="{Binding SelectionFontSize}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
       </Border>
      </Grid>
     </DataTemplate></GridView.ItemTemplate>
    </GridView>
    </Canvas>
    <ScrollViewer x:Name="PageRail" Width="14" HorizontalAlignment="Right" VerticalAlignment="Center"
        VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Hidden" HorizontalScrollMode="Disabled" IsTabStop="False">
     <StackPanel x:Name="PageSegments"/>
    </ScrollViewer>
   </Grid>
   </Grid>
   </Grid>
   <Grid x:Name="FolderBackdrop" Grid.RowSpan="2" IsHitTestVisible="False" Visibility="Collapsed">
    <Grid x:Name="FolderBlurImages"/>
    <Border x:Name="FolderShade" Background="{StaticResource DrawerShadeBrush}" Opacity="0"/>
   </Grid>
   <Canvas x:Name="DragLayer" Grid.RowSpan="2" IsHitTestVisible="False"/>
   <Border x:Name="PlacementWarning" Grid.Row="1" Visibility="Collapsed" IsHitTestVisible="False"
       HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="230" Padding="6,4"
       CornerRadius="5" Background="{StaticResource DrawerMenuBrush}">
    <TextBlock x:Name="PlacementWarningText" Foreground="{StaticResource DrawerDangerBrush}" FontSize="12"
        TextAlignment="Center" TextWrapping="Wrap"/>
   </Border>
  </Grid>
 </Border>
 </local:DrawerResizeSurface>
</Window>











<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ProductSource Condition="'$(ProductSource)' == ''">../source/Drawer</ProductSource>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(ProductSource)/Core/*.cs" Link="Core/%(Filename)%(Extension)" />
    <Compile Include="$(ProductSource)/StartupRegistration.cs" Link="StartupRegistration.cs" />
  </ItemGroup>
</Project>
